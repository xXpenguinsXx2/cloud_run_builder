# Deploy config for the "prod" environment, sourced as a Bash file by
# scripts/deploy.sh (via scripts/common.sh:load_app_config) when Cloud Build
# runs on the "prod" or "main" branch. See ../../../README.md#app-layout for
# the full format. Replace every __SET_*__ placeholder below before this file
# is used.

# Cloud Run service name. Safe to leave as-is; change only if you want a
# different service name per environment.
SERVICE_NAME=gcs-to-postgresql

# Optional runtime identity. Cloud Build passes the _RUNTIME_SERVICE_ACCOUNT
# trigger substitution in as $CLOUD_RUN_SERVICE_ACCOUNT; when empty, Cloud Run
# uses its default identity.
# RUNTIME_SERVICE_ACCOUNT=my-service-account@my-project.iam.gserviceaccount.com

# Direct PostgreSQL connection (no SSL). REQUIRED: replace the __SET_*__
# placeholders with the instance host/IP and database user.
# The password is resolved at runtime in this order: DB_PASSWORD (e.g. a
# Cloud Run secret via RUN_SECRETS=DB_PASSWORD=secret-name:latest), then the
# Secret Manager secret DB_SECRET_NAME (in DB_SECRET_PROJECT, version
# DB_SECRET_VERSION, default latest), otherwise the runtime identity's access
# token. Optional: DB_PORT (default 5432).
RUN_ENV_VARS=DB_HOST=104.198.28.244,DB_NAME=test-pg-db,DB_USER=jagirton2@gmail.com,DB_SCHEMA=public
# For Secret Manager, append ,DB_SECRET_NAME=my-pg-password,DB_SECRET_PROJECT=jag-pgsql-gke to RUN_ENV_VARS above.

# Cloud Run request timeout in seconds; generous because imports stream and
# transform large GCS objects.
RUN_TIMEOUT_SECONDS=3600
