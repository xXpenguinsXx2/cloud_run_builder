# Deploy config for the "prod" environment, sourced as a Bash file by
# scripts/deploy.sh (via scripts/common.sh:load_app_config) when Cloud Build
# runs on the "prod" or "main" branch. This app currently only has a prod.env,
# so it is only deployed from that branch (see
# scripts/common.sh:discover_app_dirs). See ../../../README.md#app-layout for
# the full format.

# Cloud Run service name. Safe to leave as-is; change only if you want a
# different service name.
SERVICE_NAME=bigquery-gcs-export

# Runtime identity the deployed Cloud Run service runs as. Cloud Build passes
# this in automatically from the _RUNTIME_SERVICE_ACCOUNT trigger substitution
# (as $CLOUD_RUN_SERVICE_ACCOUNT); the __SET_IN_TRIGGER__ fallback below is a
# guardrail that makes deploy.sh fail loudly if that substitution is missing.
# Do not hardcode a value here for Cloud Build deploys.
RUNTIME_SERVICE_ACCOUNT="${CLOUD_RUN_SERVICE_ACCOUNT:-__SET_IN_TRIGGER__}"

# App-specific config, forwarded verbatim to Cloud Run as env vars:
#   SOURCE_PROJECT      BigQuery project to read tables/queries from.
#   DESTINATION_BUCKET  GCS bucket (no gs:// prefix) the exports are written to.
#   LOCATION            BigQuery dataset/job location (e.g. US, EU, us-central1).
#   FORMAT              Export file format: CSV, JSON, AVRO, or PARQUET.
RUN_ENV_VARS=SOURCE_PROJECT=jag-pgsql-gke,DESTINATION_BUCKET=jag_bq_export_bucket,LOCATION=US,FORMAT=CSV