SERVICE_NAME=gcs-to-postgresql-helpers-dev
RUNTIME_SERVICE_ACCOUNT="${CLOUD_RUN_SERVICE_ACCOUNT:-__SET_IN_TRIGGER__}"
CLOUD_SQL_CONNECTION_NAME=__SET_CLOUD_SQL_CONNECTION_NAME__
RUN_ENV_VARS=DB_NAME=__SET_DATABASE_NAME__,DB_IAM_USER=${RUNTIME_SERVICE_ACCOUNT},DB_SCHEMA=public,CLOUD_SQL_IP_TYPE=PUBLIC
RUN_TIMEOUT_SECONDS=3600
