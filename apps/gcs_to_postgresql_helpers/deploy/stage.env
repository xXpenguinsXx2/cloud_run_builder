# Deploy config for the "stage" environment, sourced as a Bash file by
# scripts/deploy.sh (via scripts/common.sh:load_app_config) when Cloud Build
# runs on the "stage" branch. See ../../../README.md#app-layout for the full
# format. Replace every __SET_*__ placeholder below before this file is used.

# Cloud Run service name. Safe to leave as-is; change only if you want a
# different service name per environment.
SERVICE_NAME=gcs-to-postgresql-helpers-stage

# Runtime identity the deployed Cloud Run service runs as. Cloud Build passes
# this in automatically from the _RUNTIME_SERVICE_ACCOUNT trigger substitution
# (as $CLOUD_RUN_SERVICE_ACCOUNT); the __SET_IN_TRIGGER__ fallback below is a
# guardrail that makes deploy.sh fail loudly if that substitution is missing.
# Do not hardcode a value here for Cloud Build deploys.
RUNTIME_SERVICE_ACCOUNT="${CLOUD_RUN_SERVICE_ACCOUNT:-__SET_IN_TRIGGER__}"

# REQUIRED: replace with the Cloud SQL instance connection name, in the form
# "project-id:region:instance-id".
CLOUD_SQL_CONNECTION_NAME=__SET_CLOUD_SQL_CONNECTION_NAME__

# REQUIRED: replace __SET_DATABASE_NAME__ with the Cloud SQL database name.
# DB_IAM_USER is derived automatically from RUNTIME_SERVICE_ACCOUNT above by
# stripping the ".gserviceaccount.com" suffix, which is the IAM database
# username format Cloud SQL expects for IAM authentication; leave that part
# as-is. Add RUNTIME_SERVICE_ACCOUNT to the Cloud SQL instance as this IAM
# database user (see ../README.md#cloud-sql-deployment) before deploying.
RUN_ENV_VARS=DB_NAME=__SET_DATABASE_NAME__,DB_IAM_USER=${RUNTIME_SERVICE_ACCOUNT%.gserviceaccount.com},DB_SCHEMA=public,CLOUD_SQL_IP_TYPE=PUBLIC

# Cloud Run request timeout in seconds; generous because imports stream and
# transform large GCS objects.
RUN_TIMEOUT_SECONDS=3600
